<Window x:Class="Baton.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Baton — SSH handoff" Width="1260" Height="860" MinWidth="960" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,24">
      <Button x:Name="NewSession" DockPanel.Dock="Right" Content="＋ 새 SSH 세션" Click="NewSession_Click" Background="{StaticResource Accent}" Foreground="#10251D"/>
      <StackPanel><TextBlock Text="baton" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="직접 연결하고, 준비한 셸을 에이전트에 전달하세요." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="16">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="SSH 세션" FontWeight="SemiBold" Margin="0,0,0,16"/>
          <TextBlock DockPanel.Dock="Bottom" Text="각 연결은 독립된 셸을 사용합니다.&#10;전달 후에는 출력만 볼 수 있습니다." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,20,0,0"/>
          <ListBox x:Name="SessionList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Ink}" SelectionChanged="SessionList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,10"><TextBlock Text="{Binding Target}" FontWeight="SemiBold"/><TextBlock Text="{Binding Caption}" Foreground="#9FAFBE" FontSize="12" Margin="0,5,0,0"/><TextBlock Text="{Binding ShortId}" FontFamily="Consolas" Foreground="#708494" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
          <Button x:Name="CloseSsh" DockPanel.Dock="Right" Content="SSH 연결 종료" Click="CloseSsh_Click" Background="#583238" IsEnabled="False" Margin="12,0,0,0"/>
          <StackPanel><TextBlock x:Name="TargetText" Text="세션을 연결하세요" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="StateText" Text="앱이 SSH 연결을 소유합니다. 인증정보는 에이전트에 전달되지 않습니다." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="#080E14" BorderBrush="#2A3B48" BorderThickness="1" CornerRadius="6">
          <Grid>
            <TextBox x:Name="Terminal" Background="Transparent" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="16" IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="읽기 전용 SSH 터미널"/>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
              <TextBlock Text="사용자가 준비한 셸만." FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,14"/>
              <TextBlock Text="1. 새 SSH 세션에서 연결·인증&#10;2. 일반 사용자 셸과 필요한 인증 준비&#10;3. MCP 연결을 선택하고 에이전트에 전달" Foreground="{StaticResource Muted}" LineHeight="28"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource Panel}" Padding="14" CornerRadius="6" Margin="0,12,0,0">
          <StackPanel>
            <DockPanel><CheckBox x:Name="HiddenInput" DockPanel.Dock="Right" Content="숨김 입력" Checked="HiddenInput_Changed" Unchecked="HiddenInput_Changed" Margin="8,0,0,6"/><TextBlock x:Name="InputLabel" Text="사용자 입력 · 전달 전 사용" Foreground="{StaticResource Muted}" FontSize="12"/></DockPanel>
            <DockPanel>
              <Button x:Name="SendLine" DockPanel.Dock="Right" Content="전송 + Enter" Click="SendLine_Click" Margin="8,0,0,0" IsEnabled="False"/>
              <Grid><TextBox x:Name="UserInput" IsEnabled="False" MaxLength="16384" KeyDown="UserInput_KeyDown" AutomationProperties.Name="사용자 셸 입력"/><PasswordBox x:Name="SecretInput" Visibility="Collapsed" IsEnabled="False" MaxLength="16384" KeyDown="UserInput_KeyDown" AutomationProperties.Name="숨김 셸 입력"/></Grid>
            </DockPanel>
            <StackPanel x:Name="ControlKeys" Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="False">
              <Button Content="Enter" Tag="&#xD;" Click="ControlKey_Click" Padding="12,5"/><Button Content="Ctrl+C" Tag="interrupt" Click="ControlKey_Click" Padding="12,5"/><Button Content="Tab" Tag="tab" Click="ControlKey_Click" Padding="12,5"/><Button Content="Ctrl+D" Tag="eof" Click="ControlKey_Click" Padding="12,5"/>
              <TextBlock Text="120 × 32 PTY · 크기 고정" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="6" Padding="14" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="대상 MCP 연결" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/>
            <DockPanel><Button x:Name="Handoff" DockPanel.Dock="Right" Content="에이전트에 전달 →" Background="{StaticResource Accent}" Foreground="#10251D" Click="Handoff_Click" Margin="12,0,0,0" IsEnabled="False"/><ComboBox x:Name="AdapterList" DisplayMemberPath="Caption" SelectionChanged="AdapterList_SelectionChanged"/></DockPanel>
            <TextBlock Text="연결이 없으면 하네스에서 Baton MCP를 시작하세요. 전달 후 입력권은 돌아오지 않습니다." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
    <DockPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock DockPanel.Dock="Right" Text="LOCAL SSH → MCP" Foreground="#708494" FontSize="11"/><TextBlock x:Name="Notice" Text="입출력은 메모리에만 유지됩니다. 종료하면 화면과 출력 버퍼가 폐기됩니다." Foreground="{StaticResource Muted}" FontSize="12"/></DockPanel>
  </Grid>
</Window>
